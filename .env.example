NEXT_PUBLIC_SITE_URL=
# Opt-in only. Preview/staging stay noindex without this.
CIT_ALLOW_INDEXING=false

# Local or hosted demo CMS. Enables /admin with a file store
# (.data/cms locally; /tmp on Vercel — ephemeral). Prefer Supabase for durable hosting.
CIT_ADMIN_DEV_PASSWORD=
CIT_ADMIN_SESSION_SECRET=
CIT_PREVIEW_SECRET=

# Supabase (hosted CMS). Use the publishable/anon key in NEXT_PUBLIC_*.
# Never put the service-role key in NEXT_PUBLIC_* or client code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional alias used by some Supabase SSR examples
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Development people fixtures only. Never set in production.
CIT_DEV_FIXTURES=
